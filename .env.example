# Copy this file to apps/admin-web/.env.local for local development.
# Use the Project URL and anon/public publishable key from Supabase.
# These VITE_ values are included in the browser bundle and are not secrets.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# Never put service_role or a secret key in any VITE_ variable.
# Keep privileged keys only in server-side Supabase/Cloudflare secrets.
